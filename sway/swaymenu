#!/usr/bin/env bash
#
# sway-menu.sh — menu for Sway configs, networking tools, system maintenance,
#                and Wayland utilities on Debian
#
# Usage: ./sway-menu.sh
#
# Edit the CONFIG_FILES array below to match whatever's actually on your system.

set -uo pipefail

EDITOR="${EDITOR:-nvim}"

# --- Styling ----------------------------------------------------------------
BOLD="\e[1m"
RESET="\e[0m"
CYAN="\e[1;36m"

banner() {
    printf "${CYAN}"
    cat <<'LOGO'
     _______.____    __    ____  ___   ____    ____    .___  ___.  _______ .__   __.  __    __
    /       |\   \  /  \  /   / /   \  \   \  /   /    |   \/   | |   ____||  \ |  | |  |  |  |
   |   (----` \   \/    \/   / /  ^  \  \   \/   /     |  \  /  | |  |__   |   \|  | |  |  |  |
    \   \      \            / /  /_\  \  \_    _/      |  |\/|  | |   __|  |  . `  | |  |  |  |
.----)   |      \    /\    / /  _____  \   |  |        |  |  |  | |  |____ |  |\   | |  `--'  |
|_______/        \__/  \__/ /__/     \__\  |__|        |__|  |__| |_______||__| \__|  \______/
LOGO
    printf "${RESET}\n"
}

# Label|Path pairs. Comment out / add lines to match your actual setup.
CONFIG_FILES=(
    "Sway main config|$HOME/.config/sway/config"
    "Waybar config|$HOME/.config/waybar/config"
    "Waybar style (CSS)|$HOME/.config/waybar/style.css"
    "Rofi config|$HOME/.config/rofi/config.rasi"
    "Foot terminal config|$HOME/.config/foot/foot.conf"
)

pause() {
    read -rp $'\nPress Enter to continue...'
}

check_cmd() {
    command -v "$1" &>/dev/null
}

# Offers to install a missing apt package, then re-checks for the command.
ensure_cmd() {
    local cmd="$1" pkg="${2:-$1}"
    if check_cmd "$cmd"; then
        return 0
    fi
    echo "'$cmd' not found."
    read -rp "Install package '$pkg' now? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        sudo apt install -y "$pkg"
    fi
    check_cmd "$cmd"
}

menu_header() {
    clear
    banner
    if [[ -n "$1" ]]; then
        echo -e "${BOLD}$1${RESET}"
        echo
    fi
}

# =============================================================================
# Sway config editing
# =============================================================================

edit_file() {
    local path="$1"
    local dir
    dir="$(dirname "$path")"

    if [[ ! -f "$path" ]]; then
        echo "File not found: $path"
        read -rp "Create it? [y/N] " ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            mkdir -p "$dir"
            touch "$path"
        else
            return
        fi
    fi

    "$EDITOR" "$path"
}

reload_sway() {
    if check_cmd swaymsg; then
        swaymsg reload && echo "Sway config reloaded."
    else
        echo "swaymsg not found — are you running this inside Sway?"
    fi
    pause
}

show_config_menu() {
    while true; do
        menu_header "Sway Config Files"
        local i=1
        for entry in "${CONFIG_FILES[@]}"; do
            local label="${entry%%|*}"
            local path="${entry#*|}"
            if [[ -f "$path" ]]; then
                printf "  ${BOLD}%2d)${RESET} %-28s ${BOLD}[found]${RESET}\n" "$i" "$label"
            else
                printf "  ${BOLD}%2d)${RESET} %-28s [missing]\n" "$i" "$label"
            fi
            ((i++))
        done
        echo -e "   ${BOLD}0)${RESET} Back to main menu"
        echo
        read -rp "$(echo -e ${BOLD}'Select a file to edit: '${RESET})" choice

        if [[ "$choice" == "0" ]]; then
            return
        elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#CONFIG_FILES[@]} )); then
            local entry="${CONFIG_FILES[$((choice-1))]}"
            edit_file "${entry#*|}"
        else
            echo "Invalid selection."
            pause
        fi
    done
}

# =============================================================================
# Networking tools
# =============================================================================

launch_wireshark() {
    if ensure_cmd wireshark wireshark; then
        echo "Launching Wireshark..."
        nohup wireshark >/dev/null 2>&1 &
        disown
    fi
    pause
}

tcpdump_capture() {
    ensure_cmd tcpdump tcpdump || { pause; return; }
    read -rp "Interface to capture on (blank = any): " iface
    iface="${iface:-any}"
    read -rp "Number of packets to capture (blank = unlimited, Ctrl+C to stop): " count
    read -rp "Optional filter expression (e.g. 'port 80'): " filt
    local cmd=(sudo tcpdump -i "$iface")
    [[ -n "$count" ]] && cmd+=(-c "$count")
    echo "Running: ${cmd[*]} $filt"
    # shellcheck disable=SC2086
    "${cmd[@]}" $filt
    pause
}

nm_menu() {
    while true; do
        menu_header "NetworkManager"
        echo -e "  ${BOLD}1)${RESET} Open nmtui (full TUI)"
        echo -e "  ${BOLD}2)${RESET} Show connection status"
        echo -e "  ${BOLD}3)${RESET} List available Wi-Fi networks"
        echo -e "  ${BOLD}4)${RESET} Connect to a Wi-Fi network"
        echo -e "  ${BOLD}5)${RESET} Toggle Wi-Fi on/off"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1) ensure_cmd nmtui network-manager && nmtui ;;
            2) nmcli general status; echo; nmcli connection show; pause ;;
            3) nmcli device wifi list; pause ;;
            4)
                read -rp "SSID: " ssid
                read -rsp "Password (leave blank for open network): " pw
                echo
                if [[ -z "$pw" ]]; then
                    nmcli device wifi connect "$ssid"
                else
                    nmcli device wifi connect "$ssid" password "$pw"
                fi
                pause
                ;;
            5)
                read -rp "Turn Wi-Fi on or off? [on/off]: " state
                nmcli radio wifi "$state"
                pause
                ;;
            0) return ;;
            *) echo "Invalid option."; pause ;;
        esac
    done
}

