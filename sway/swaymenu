# =============================================================================
# Wayland / Sway utilities
# =============================================================================

screenshot_tool() {
    if ! ensure_cmd grim grim; then
        pause
        return
    fi
    local outdir="$HOME/Pictures"
    mkdir -p "$outdir"
    local file="$outdir/screenshot-$(date +%Y%m%d-%H%M%S).png"
    echo -e "  ${BOLD}1)${RESET} Full screen"
    echo -e "  ${BOLD}2)${RESET} Select a region"
    read -rp "Choose an option: " c
    case "$c" in
        1) grim "$file" && echo "Saved to $file" ;;
        2)
            if ensure_cmd slurp slurp; then
                grim -g "$(slurp)" "$file" && echo "Saved to $file"
            fi
            ;;
        *) return ;;
    esac
    pause
}

clipboard_tool() {
    if ! ensure_cmd wl-copy wl-clipboard; then
        pause
        return
    fi
    echo -e "  ${BOLD}1)${RESET} Show current clipboard content"
    echo -e "  ${BOLD}2)${RESET} Clear clipboard"
    read -rp "Choose an option: " c
    case "$c" in
        1) wl-paste ;;
        2) wl-copy --clear ;;
    esac
    pause
}

lock_screen_tool() {
    ensure_cmd swaylock swaylock && swaylock
}

brightness_tool() {
    if ! ensure_cmd brightnessctl brightnessctl; then
        pause
        return
    fi
    echo "Current brightness:"
    brightnessctl
    read -rp "Set brightness % (blank to skip): " pct
    [[ -n "$pct" ]] && brightnessctl set "${pct}%"
    pause
}

audio_tool() {
    if check_cmd pamixer; then
        echo -e "  ${BOLD}1)${RESET} Show volume"
        echo -e "  ${BOLD}2)${RESET} Set volume"
        echo -e "  ${BOLD}3)${RESET} Mute toggle"
        read -rp "Choose an option: " c
        case "$c" in
            1) pamixer --get-volume ;;
            2) read -rp "Volume %: " v; pamixer --set-volume "$v" ;;
            3) pamixer --toggle-mute ;;
        esac
    elif check_cmd pactl; then
        echo -e "  ${BOLD}1)${RESET} List audio sinks"
        echo -e "  ${BOLD}2)${RESET} Set volume"
        echo -e "  ${BOLD}3)${RESET} Mute toggle"
        read -rp "Choose an option: " c
        case "$c" in
            1) pactl list short sinks ;;
            2) read -rp "Volume % (e.g. 50): " v; pactl set-sink-volume @DEFAULT_SINK@ "${v}%" ;;
            3) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
        esac
    else
        echo "Neither pamixer nor pactl is installed."
        read -rp "Install pamixer now? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] && sudo apt install -y pamixer
    fi
    pause
}

media_tool() {
    if ! ensure_cmd playerctl playerctl; then
        pause
        return
    fi
    echo -e "  ${BOLD}1)${RESET} Play/Pause"
    echo -e "  ${BOLD}2)${RESET} Next track"
    echo -e "  ${BOLD}3)${RESET} Previous track"
    echo -e "  ${BOLD}4)${RESET} Show current status"
    read -rp "Choose an option: " c
    case "$c" in
        1) playerctl play-pause ;;
        2) playerctl next ;;
        3) playerctl previous ;;
        4) playerctl status; playerctl metadata ;;
    esac
    pause
}

kanshi_tool() {
    echo -e "  ${BOLD}1)${RESET} Show kanshi status"
    echo -e "  ${BOLD}2)${RESET} Restart kanshi"
    read -rp "Choose an option: " c
    case "$c" in
        1) systemctl --user status kanshi ;;
        2) systemctl --user restart kanshi ;;
    esac
    pause
}

