# =============================================================================
# Bash tools
# =============================================================================

open_bash_shell() {
    echo "Dropping into a bash shell. Type 'exit' to return to the menu."
    ( cd "$HOME" && bash )
}

bash_menu() {
    while true; do
        menu_header "Bash Tools"
        echo -e "  ${BOLD}1)${RESET} Open a bash shell"
        echo -e "  ${BOLD}2)${RESET} Edit ~/.bashrc"
        echo -e "  ${BOLD}3)${RESET} Edit ~/.bash_aliases"
        echo -e "  ${BOLD}4)${RESET} Edit ~/.bash_profile"
        echo -e "  ${BOLD}5)${RESET} Edit ~/.profile"
        echo -e "  ${BOLD}6)${RESET} Edit /etc/bash.bashrc (system-wide, sudo)"
        echo -e "  ${BOLD}7)${RESET} Reload ~/.bashrc in this shell"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1) open_bash_shell ;;
            2) edit_file "$HOME/.bashrc" ;;
            3) edit_file "$HOME/.bash_aliases" ;;
            4) edit_file "$HOME/.bash_profile" ;;
            5) edit_file "$HOME/.profile" ;;
            6)
                if [[ -f /etc/bash.bashrc ]]; then
                    sudo "$EDITOR" /etc/bash.bashrc
                else
                    echo "/etc/bash.bashrc not found on this system."
                    pause
                fi
                ;;
            7)
                if [[ -f "$HOME/.bashrc" ]]; then
                    # shellcheck disable=SC1090
                    source "$HOME/.bashrc"
                    echo "Reloaded ~/.bashrc into this menu's shell (won't affect other open terminals)."
                else
                    echo "~/.bashrc not found."
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid option."; pause ;;
        esac
    done
}

