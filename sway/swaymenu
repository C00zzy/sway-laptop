nmap_menu() {
    if ! ensure_cmd nmap nmap; then
        pause
        return
    fi
    while true; do
        menu_header "Nmap Scans"
        echo -e "  ${BOLD}1)${RESET} Ping scan a subnet (host discovery)"
        echo -e "  ${BOLD}2)${RESET} Fast scan of a host (top ports)"
        echo -e "  ${BOLD}3)${RESET} Full port scan of a host (all 65535 ports)"
        echo -e "  ${BOLD}4)${RESET} OS detection scan (requires sudo)"
        echo -e "  ${BOLD}5)${RESET} Custom scan (your own flags)"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1) read -rp "Subnet (e.g. 192.168.1.0/24): " t; nmap -sn "$t"; pause ;;
            2) read -rp "Target host/IP: " t; nmap -F "$t"; pause ;;
            3) read -rp "Target host/IP: " t; nmap -p- "$t"; pause ;;
            4) read -rp "Target host/IP: " t; sudo nmap -O "$t"; pause ;;
            5)
                read -rp "Target host/IP: " t
                read -rp "Extra nmap flags (e.g. -sV -p 22,80,443): " f
