# =============================================================================
# System tools
# =============================================================================

apt_update_system() {
    echo "Updating package lists..."
    sudo apt update
    echo
    echo "Upgrading installed packages..."
    sudo apt full-upgrade -y
    pause
}

apt_autoremove_orphans() {
    echo "Running apt autoremove..."
    sudo apt autoremove -y
    if check_cmd deborphan; then
        echo
        echo "Checking for additional orphaned libraries with deborphan..."
        local orphans
        orphans="$(deborphan)"
        if [[ -n "$orphans" ]]; then
            echo "$orphans"
            read -rp "Purge these packages? [y/N] " ans
            if [[ "$ans" =~ ^[Yy]$ ]]; then
                # shellcheck disable=SC2086
                sudo apt purge -y $orphans
            fi
        else
            echo "No additional orphans found."
        fi
    else
        echo "(Tip: install 'deborphan' for a more thorough orphan check.)"
    fi
    pause
}

apt_update_mirrors() {
    if ! ensure_cmd netselect-apt netselect-apt; then
        pause
        return
    fi
    read -rp "Debian release codename (e.g. bookworm, trixie): " release
    [[ -z "$release" ]] && { echo "No release given."; pause; return; }

    sudo netselect-apt "$release" -o /tmp/sources.list.new
    echo
    echo "New sources list generated at /tmp/sources.list.new"
    read -rp "Back up /etc/apt/sources.list and replace it with the new one? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        sudo cp /etc/apt/sources.list "/etc/apt/sources.list.bak.$(date +%s)"
        sudo cp /tmp/sources.list.new /etc/apt/sources.list
        sudo apt update
    fi
    pause
}

apt_install_package() {
    read -rp "Package name to install: " pkg
    [[ -z "$pkg" ]] && return
    sudo apt install -y "$pkg"
    pause
}

apt_remove_package() {
    read -rp "Package name to remove: " pkg
    [[ -z "$pkg" ]] && return
    read -rp "Purge config files too instead of a plain remove? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        sudo apt purge -y "$pkg"
    else
        sudo apt remove -y "$pkg"
    fi
    pause
}

apt_menu() {
    while true; do
        menu_header "APT Package Management"
        echo -e "  ${BOLD}1)${RESET} Update system (apt update && full-upgrade)"
        echo -e "  ${BOLD}2)${RESET} Autoremove orphaned packages"
        echo -e "  ${BOLD}3)${RESET} Update mirrors (netselect-apt)"
        echo -e "  ${BOLD}4)${RESET} Install a package"
        echo -e "  ${BOLD}5)${RESET} Remove a package"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1) apt_update_system ;;
            2) apt_autoremove_orphans ;;
            3) apt_update_mirrors ;;
            4) apt_install_package ;;
            5) apt_remove_package ;;
            0) return ;;
            *) echo "Invalid option."; pause ;;
        esac
    done
}

syslog_menu() {
    while true; do
        menu_header "Linux System Logs"
        echo -e "  ${BOLD}1)${RESET} View recent logs (last 100 lines, journalctl)"
        echo -e "  ${BOLD}2)${RESET} Follow logs live (journalctl -f, Ctrl+C to stop)"
        echo -e "  ${BOLD}3)${RESET} View kernel messages (dmesg)"
        echo -e "  ${BOLD}4)${RESET} View /var/log/syslog"
        echo -e "  ${BOLD}5)${RESET} View /var/log/auth.log"
        echo -e "  ${BOLD}6)${RESET} Search logs for a keyword"
        echo -e "  ${BOLD}7)${RESET} View logs for a specific service"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1)
                if check_cmd journalctl; then
                    journalctl -n 100 --no-pager
                else
                    echo "journalctl not found (not a systemd system?)."
                fi
                pause
                ;;
            2)
                if check_cmd journalctl; then
                    journalctl -f
                else
                    echo "journalctl not found (not a systemd system?)."
                    pause
                fi
                ;;
            3)
                if check_cmd dmesg; then
                    dmesg -T --color=always | less -R
                else
                    echo "dmesg not found."
                    pause
                fi
                ;;
            4)
                if [[ -f /var/log/syslog ]]; then
                    sudo less /var/log/syslog
                else
                    echo "/var/log/syslog not found (this system may only use journalctl)."
                    pause
                fi
                ;;
            5)
                if [[ -f /var/log/auth.log ]]; then
                    sudo less /var/log/auth.log
                else
                    echo "/var/log/auth.log not found."
                    pause
                fi
                ;;
            6)
                read -rp "Keyword to search for: " kw
                [[ -z "$kw" ]] && continue
                if check_cmd journalctl; then
                    journalctl --no-pager -g "$kw" | tail -n 200
                elif [[ -f /var/log/syslog ]]; then
                    sudo grep -i "$kw" /var/log/syslog | tail -n 200
                else
                    echo "No log source available to search."
                fi
                pause
                ;;
            7)
                read -rp "Service/unit name: " svc
                [[ -z "$svc" ]] && continue
                if check_cmd journalctl; then
                    journalctl -u "$svc" -n 200 --no-pager
                else
                    echo "journalctl not found (not a systemd system?)."
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid option."; pause ;;
        esac
    done
}

