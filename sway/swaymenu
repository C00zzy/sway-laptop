        echo -e "  ${BOLD}5)${RESET} Wayland / Sway utilities"
        echo -e "  ${BOLD}6)${RESET} Bash tools"
        echo -e "  ${BOLD}7)${RESET} Open a shell in ~/.config/sway"
        echo -e "  ${BOLD}0)${RESET} Exit"
        echo
        read -rp "$(echo -e ${BOLD}'Choose an option: '${RESET})" choice

        case "$choice" in
            1) show_config_menu ;;
            2) reload_sway ;;
            3) networking_menu ;;
            4) system_menu ;;
            5) wayland_menu ;;
