main_menu() {
    while true; do
        menu_header ""
        echo -e "  ${BOLD}1)${RESET} Edit a Sway/related config file"
        echo -e "  ${BOLD}2)${RESET} Reload Sway config"
        echo -e "  ${BOLD}3)${RESET} Networking tools"
