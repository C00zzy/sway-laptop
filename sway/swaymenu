ip_mac_menu() {
    while true; do
        menu_header "IP & MAC Addressing Info"
        echo -e "  ${BOLD}1)${RESET} Show all IP addresses (per interface)"
        echo -e "  ${BOLD}2)${RESET} Show interface MAC addresses"
        echo -e "  ${BOLD}3)${RESET} Show routing table"
        echo -e "  ${BOLD}4)${RESET} Show ARP / neighbor table"
        echo -e "  ${BOLD}5)${RESET} Show DNS resolver info"
        echo -e "  ${BOLD}6)${RESET} Check public IP address (needs internet)"
        echo -e "  ${BOLD}0)${RESET} Back"
        echo
        read -rp "Choose an option: " c
        case "$c" in
            1) ip -c addr show; pause ;;
            2) ip -c link show; pause ;;
            3) ip -c route show; pause ;;
            4) ip -c neigh show; pause ;;
            5)
                if check_cmd resolvectl; then
                    resolvectl status
                elif [[ -f /etc/resolv.conf ]]; then
                    cat /etc/resolv.conf
                else
                    echo "No DNS resolver info found."
                fi
                pause
                ;;
            6)
                if check_cmd curl; then
                    curl -s ifconfig.me && echo
                elif check_cmd wget; then
                    wget -qO- ifconfig.me && echo
                else
                    echo "Neither curl nor wget is installed."
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid option."; pause ;;
        esac
    done
}

